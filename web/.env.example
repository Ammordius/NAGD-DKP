# Copy to .env.local and fill in from Supabase → Settings → API
VITE_SUPABASE_URL=https://xxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# Browser tab title, sign-in heading, Home heading, and the Site Admin heading suffix.
# Set this per deployment (Vercel project env, or .env.local) so development,
# staging, and production can share the same code and still be told apart.
# When unset, the title is "NAGD DKP - Development".
# Display text only — does not control development warnings.
# VITE_SITE_TITLE=NAGD DKP - Staging Site

# Deployment environment for warnings/banners: production | staging | development.
# Only "production" hides the development banner and DKP warning.
# Missing, blank, or any other value defaults to non-production (warnings shown).
# VITE_SITE_ENV=development
#
# Profile load failures always show a user message with a report code
# (e.g. AUTH-PROFILE-406-PGRST116-SESS) plus a sanitized debug line
# (http/code/session present|missing/host; never keys). No extra env flag.

# Optional: hosted class_rankings.json (Magelo export) for Raider Activity “Reload coverage”.
# Same artifact as GitHub secret CLASS_RANKINGS_URL for the class_coverage CI job.
# Allowed by CSP connect-src when using the guild export host.
# VITE_CLASS_RANKINGS_URL=https://ammordius.github.io/NAGD-spell-inventory/class_rankings.json

# Set to false to hide "Sign up" on login (invite-only; also disable signups in Supabase Auth).
# VITE_ALLOW_SIGNUP=false

# Server-only key for POST /api/delete-site-user (auth.admin.deleteUser).
# Set this in Vercel and, for local npm run dev, in web/.env.local or the repo root .env.
# Never prefix it with VITE_. That would ship the key to the browser.
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
